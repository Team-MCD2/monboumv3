# ═══════════════════════════════════════════════════════════════
# Mon Boum V3 — Environment variables template
# Copy to `.env` and fill with real values. `.env` is gitignored.
# All PUBLIC_* vars are safe to embed in client JS (EmailJS design).
# ═══════════════════════════════════════════════════════════════

# ── EmailJS (frontend-only contact / franchise forms) ────────────
# Get these 3 values from https://dashboard.emailjs.com/
#   1. Public Key → Account tab
#   2. Service ID → Email Services
#   3. Template IDs → Email Templates (create 2 templates)
PUBLIC_EMAILJS_PUBLIC_KEY=
PUBLIC_EMAILJS_SERVICE_ID=
PUBLIC_EMAILJS_TEMPLATE_CONTACT=
PUBLIC_EMAILJS_TEMPLATE_FRANCHISE=

# ── Google Analytics 4 (optional) ────────────────────────────────
# Measurement ID — looks like G-XXXXXXXXXX
PUBLIC_GA4_ID=
