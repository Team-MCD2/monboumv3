---
// ═══════════════════════════════════════════════════════════════
// /nos-restaurants — 10 Mon Boum locations with enseigne filter
// Data: src/data/restaurants.js
// Filter: vanilla JS + data attrs (no React island needed)
// ═══════════════════════════════════════════════════════════════
import Layout from '../layouts/Layout.astro';
import GrungeSeparator from '../components/GrungeSeparator.astro';
import { RESTAURANTS, ENSEIGNES, TOTAL_RESTAURANTS } from '../data/restaurants.js';

const title = `Nos ${TOTAL_RESTAURANTS} restaurants à Toulouse — Mon Boum`;
const description = `Découvrez les ${TOTAL_RESTAURANTS} restaurants Mon Boum à Toulouse et métropole. Adresses, téléphones, drives — retrouvez votre Boum le plus proche.`;

// Filters: "all" + each enseigne
const FILTERS = [
  { slug: 'all', label: `Tous (${TOTAL_RESTAURANTS})`, color: '#111111' },
  ...Object.values(ENSEIGNES).map((e) => ({
    slug: e.slug,
    label: `${e.nom} (${RESTAURANTS.filter((r) => r.enseigne === e.slug).length})`,
    color: e.color,
  })),
];

// Build a maps URL for a restaurant
const mapsUrl = (r) =>
  `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
    `${r.adresse}, ${r.cp} ${r.ville}`
  )}`;
---

<Layout title={title} description={description}>
  {/* ═══════════════ HERO ═══════════════ */}
  <section
    class="relative texture-bg overflow-hidden"
    style="padding-top: var(--hh);"
  >
    <img
      src="/assets/shapes/shape1-min.png"
      alt=""
      aria-hidden="true"
      class="absolute top-24 -left-12 w-48 md:w-64 opacity-10 spin-slow"
      data-parallax="0.15"
    />
    <img
      src="/assets/shapes/shape2-min.png"
      alt=""
      aria-hidden="true"
      class="absolute bottom-16 right-8 w-32 opacity-20 float-anim"
      data-parallax="0.2"
    />

    <div class="container-wide relative z-10 py-16 md:py-24">
      <p class="rise-1 font-body text-xs md:text-sm text-rouge uppercase tracking-[0.3em] mb-4">
        Mon Boum · Toulouse & métropole
      </p>
      <h1 class="rise-2 font-display text-white uppercase leading-[0.9] text-5xl md:text-7xl lg:text-8xl max-w-3xl">
        Nos <span class="text-rouge">{TOTAL_RESTAURANTS} restaurants</span>.
      </h1>
      <p class="rise-3 font-body text-white/70 text-lg md:text-xl mt-8 max-w-2xl">
        Retrouvez le Boum le plus proche de chez vous — <strong class="text-white">4 enseignes</strong>
        pour se régaler à Toulouse, Colomiers, Aucamville et Mermoz.
      </p>
    </div>
  </section>

  <GrungeSeparator fromDark={true} />

  {/* ═══════════════ FILTER + GRID ═══════════════ */}
  <section class="bg-white py-16 md:py-24">
    <div class="container-wide">
      {/* Filter pills */}
      <div
        class="flex flex-wrap justify-center gap-2 md:gap-3 mb-12"
        role="tablist"
        aria-label="Filtrer par enseigne"
        data-reveal
      >
        {FILTERS.map((f, i) => (
          <button
            type="button"
            class={`filter-pill font-display uppercase text-xs md:text-sm tracking-wider px-5 py-3 border-2 transition-colors ${
              i === 0
                ? 'bg-noir text-white border-noir is-active'
                : 'bg-white text-noir border-noir/15 hover:border-noir hover:bg-noir hover:text-white'
            }`}
            data-filter={f.slug}
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
          >
            {f.label}
          </button>
        ))}
      </div>

      {/* Results grid */}
      <div
        id="restaurants-grid"
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"
      >
        {RESTAURANTS.map((r, i) => {
          const enseigne = ENSEIGNES[r.enseigne];
          return (
            <article
              class="restaurant-card bg-white border-2 border-noir/10 hover:border-rouge hover:shadow-xl transition-all relative overflow-hidden group"
              data-enseigne={r.enseigne}
              data-reveal
              data-d={String(Math.min((i % 4) + 1, 4))}
            >
              {/* Color stripe top */}
              <div
                class="h-1.5 w-full"
                style={`background-color: ${enseigne.color};`}
              />

              <div class="p-6">
                <div class="flex items-start justify-between gap-2 mb-4">
                  <div>
                    <p
                      class="font-body text-xs uppercase tracking-[0.2em] mb-1"
                      style={`color: ${enseigne.color};`}
                    >
                      {enseigne.nom}
                    </p>
                    <h3 class="font-display text-2xl text-noir uppercase leading-tight">
                      {r.nom}
                    </h3>
                  </div>
                  {r.drive && (
                    <span class="font-body text-[0.65rem] bg-rouge text-white px-2 py-1 uppercase tracking-wider shrink-0">
                      Drive
                    </span>
                  )}
                </div>

                <address class="font-body text-sm text-noir/70 not-italic space-y-0.5 mb-4">
                  <p>{r.adresse}</p>
                  <p>{r.cp} {r.ville}</p>
                </address>

                {r.tel && (
                  <a
                    href={`tel:${r.tel.replace(/\s/g, '')}`}
                    class="inline-block font-body text-sm text-rouge hover:underline mb-3"
                  >
                    📞 {r.tel}
                  </a>
                )}

                {r.horaires && (
                  <p class="font-body text-xs text-noir/60 mb-3 italic">
                    🕒 {r.horaires}
                  </p>
                )}

                {r.note && (
                  <p class="font-body text-xs text-noir/50 mb-4 border-l-2 border-noir/10 pl-3 italic">
                    ℹ {r.note}
                  </p>
                )}

                <div class="flex flex-wrap gap-2 mt-4 pt-4 border-t border-noir/10">
                  <a
                    href={mapsUrl(r)}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-body text-xs bg-noir text-white px-3 py-2 uppercase tracking-wider hover:bg-rouge transition-colors"
                  >
                    Itinéraire
                  </a>
                  <a
                    href={enseigne.path}
                    class="font-body text-xs border border-noir/20 text-noir px-3 py-2 uppercase tracking-wider hover:bg-noir hover:text-white transition-colors"
                  >
                    {enseigne.nom}
                  </a>
                </div>
              </div>
            </article>
          );
        })}
      </div>

      {/* Empty state (hidden by default, shown by script if filter has 0 results) */}
      <p
        id="empty-state"
        class="hidden text-center font-body text-noir/50 italic mt-12"
      >
        Aucun restaurant trouvé pour ce filtre.
      </p>
    </div>
  </section>

  {/* ═══════════════ CTA ═══════════════ */}
  <section class="bg-rouge py-16 md:py-20">
    <div class="container-wide text-center">
      <h2 class="font-display text-4xl md:text-5xl text-white uppercase leading-none mb-8" data-reveal>
        Une envie, <span class="text-noir">un boum</span>.
      </h2>
      <a
        href="https://monboum.commande.deliveroo.fr/fr/"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block bg-white text-rouge font-display uppercase text-lg px-12 py-5 hover:bg-noir hover:text-white transition-colors"
        data-reveal
        data-d="2"
      >
        Commander en ligne
      </a>
    </div>
  </section>
</Layout>

<script>
  // Vanilla filter logic — no React island needed
  document.addEventListener('DOMContentLoaded', () => {
    const pills = document.querySelectorAll<HTMLButtonElement>('.filter-pill');
    const cards = document.querySelectorAll<HTMLElement>('.restaurant-card');
    const emptyState = document.getElementById('empty-state');

    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        const filter = pill.dataset.filter;
        if (!filter) return;

        // Update pill states
        pills.forEach((p) => {
          const active = p === pill;
          p.classList.toggle('is-active', active);
          p.setAttribute('aria-selected', active ? 'true' : 'false');
          if (active) {
            p.classList.remove('bg-white', 'text-noir', 'border-noir/15');
            p.classList.add('bg-noir', 'text-white', 'border-noir');
          } else {
            p.classList.add('bg-white', 'text-noir', 'border-noir/15');
            p.classList.remove('bg-noir', 'text-white', 'border-noir');
          }
        });

        // Filter cards
        let visibleCount = 0;
        cards.forEach((card) => {
          const matches = filter === 'all' || card.dataset.enseigne === filter;
          card.style.display = matches ? '' : 'none';
          if (matches) visibleCount++;
        });

        // Toggle empty state
        if (emptyState) {
          emptyState.classList.toggle('hidden', visibleCount > 0);
        }
      });
    });
  });
</script>
