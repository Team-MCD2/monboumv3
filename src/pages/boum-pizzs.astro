---
// ═══════════════════════════════════════════════════════════════
// /boum-pizzs — Enseigne Boum Pizz's (4 locations, some with notes)
// Hero banner: Boum-Pizzs-1.png (Pass A asset)
// ═══════════════════════════════════════════════════════════════
import Layout from '../layouts/Layout.astro';
import GrungeSeparator from '../components/GrungeSeparator.astro';
import {
  byEnseigne,
  ENSEIGNES,
  buildEnseigneGraph,
} from '../data/restaurants.js';

const enseigne = ENSEIGNES['boum-pizzs'];
const locations = byEnseigne('boum-pizzs');

const schema = buildEnseigneGraph('boum-pizzs', Astro.site?.toString() || 'https://mon-boum.vercel.app');

const title = `${enseigne.nom} Toulouse — Pizza & Tacos Halal | Mon Boum`;
const description =
  "Boum Pizz's : pizzas artisanales et tacos halal à Toulouse. 4 restaurants dans la métropole — commandez en livraison ou venez sur place.";
---

<Layout title={title} description={description} schema={schema}>
  {/* ═══════════════ HERO ═══════════════ */}
  <section
    class="relative texture-bg overflow-hidden"
    style="padding-top: var(--hh);"
  >
    <img
      src="/assets/shapes/shape1-min.png"
      alt=""
      aria-hidden="true"
      class="absolute top-24 -left-12 w-48 md:w-64 opacity-10 spin-slow"
      data-parallax="0.15"
    />
    <img
      src="/assets/shapes/shape3-min.png"
      alt=""
      aria-hidden="true"
      class="absolute bottom-12 right-12 w-32 md:w-48 opacity-20 float-anim"
      data-parallax="0.2"
    />

    <div class="container-wide relative z-10 py-16 md:py-20">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <p class="rise-1 font-body text-xs md:text-sm text-rouge uppercase tracking-[0.3em] mb-4">
            {enseigne.label}
          </p>
          <h1 class="rise-2 font-display text-white uppercase leading-[0.9] text-5xl md:text-7xl lg:text-8xl">
            BOUM<br />
            <span class="text-rouge">PIZZ'S.</span>
          </h1>
          <p class="rise-3 font-body text-white/70 text-lg md:text-xl mt-6 max-w-lg">
            Pizzas artisanales et tacos <strong class="text-white">halal</strong>,
            cuisinés avec passion dans nos 4 restaurants toulousains.
          </p>

          <div class="rise-4 mt-8 flex flex-wrap gap-4">
            <a
              href={locations[0]?.deliverooUrl || 'https://monboum.commande.deliveroo.fr/fr/'}
              target="_blank"
              rel="noopener noreferrer"
              class="bg-rouge text-white font-display uppercase text-base px-8 py-4 hover:bg-white hover:text-noir transition-colors"
            >
              Commander
            </a>
            <a
              href="#locations"
              class="border border-white/30 text-white font-display uppercase text-base px-8 py-4 hover:bg-white hover:text-noir transition-colors"
            >
              Nos adresses
            </a>
          </div>
        </div>

        <div class="relative img-zoom">
          <img
            src="/assets/banners/Boum-Pizzs-1.png"
            alt="Boum Pizz's — Pizza & Tacos halal"
            class="w-full h-auto"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </section>

  <GrungeSeparator fromDark={true} />

  {/* ═══════════════ CONCEPT ═══════════════ */}
  <section class="bg-white py-20 md:py-28">
    <div class="container-wide">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <div data-reveal>
          <p class="font-body text-xs text-rouge uppercase tracking-[0.3em] mb-4">
            Notre concept
          </p>
          <h2 class="font-display text-4xl md:text-5xl text-noir uppercase leading-none mb-6">
            Pizza <span class="text-rouge">&</span><br />
            tacos halal.
          </h2>
          <div class="space-y-4 font-body text-noir/70">
            <p>
              Des <strong>pizzas artisanales</strong> à la pâte fine, généreusement
              garnies, et des <strong>tacos halal</strong> ultra-gourmands.
            </p>
            <p>
              Parfait en livraison ou sur place — 4 adresses dans la région
              toulousaine pour se régaler.
            </p>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4" data-reveal data-d="2">
          <div class="bg-gris p-6 text-center col-span-2">
            <p class="font-display text-4xl text-rouge mb-1">{locations.length} adresses</p>
            <p class="font-body text-xs uppercase tracking-wider text-noir/60">
              à Toulouse et métropole
            </p>
          </div>
          <div class="bg-noir text-white p-6 text-center">
            <p class="font-display text-3xl text-rouge mb-1">Pizza</p>
            <p class="font-body text-xs uppercase tracking-wider text-white/60">Artisanale</p>
          </div>
          <div class="bg-noir text-white p-6 text-center">
            <p class="font-display text-3xl text-rouge mb-1">Tacos</p>
            <p class="font-body text-xs uppercase tracking-wider text-white/60">Halal</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ═══════════════ LOCATIONS ═══════════════ */}
  <section id="locations" class="bg-gris py-20 md:py-28 scroll-mt-24">
    <div class="container-wide">
      <div class="text-center mb-16" data-reveal>
        <p class="font-body text-xs text-rouge uppercase tracking-[0.3em] mb-4">
          Nos adresses
        </p>
        <h2 class="font-display text-4xl md:text-5xl text-noir uppercase leading-none">
          Retrouvez-nous<br />
          <span class="text-rouge">à Toulouse</span>.
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
        {locations.map((loc, i) => (
          <div
            class="bg-white p-8 hover:shadow-xl transition-shadow"
            data-reveal
            data-d={String(Math.min(i + 1, 4))}
          >
            <h3 class="font-display text-2xl text-noir uppercase mb-4">
              Boum Pizz's <span class="text-rouge">{loc.nom}</span>
            </h3>
            <address class="font-body text-noir/70 not-italic text-sm space-y-1">
              <p>{loc.adresse}</p>
              <p>{loc.cp} {loc.ville}</p>
              {loc.tel && (
                <p class="mt-3">
                  <a
                    href={`tel:${loc.tel.replace(/\s/g, '')}`}
                    class="text-rouge hover:underline font-medium"
                  >
                    📞 {loc.tel}
                  </a>
                </p>
              )}
            </address>
            {loc.note && (
              <p class="mt-4 pt-4 border-t border-noir/10 font-body text-xs italic text-noir/50">
                ℹ {loc.note}
              </p>
            )}
            <div class="flex flex-wrap gap-2 mt-6 pt-4 border-t border-noir/10">
              <a
                href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
                  `${loc.adresse}, ${loc.cp} ${loc.ville}`
                )}`}
                target="_blank"
                rel="noopener noreferrer"
                class="font-body text-xs bg-noir text-white px-3 py-2 uppercase tracking-wider hover:bg-rouge transition-colors"
              >
                Itinéraire
              </a>
              {loc.deliverooUrl && (
                <a
                  href={loc.deliverooUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-body text-xs bg-rouge text-white px-3 py-2 uppercase tracking-wider hover:bg-noir transition-colors"
                >
                  Commander
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ═══════════════ CTA ═══════════════ */}
  <section class="bg-rouge py-16 md:py-20">
    <div class="container-wide text-center">
      <h2 class="font-display text-4xl md:text-5xl text-white uppercase leading-none mb-8" data-reveal>
        Une envie de <span class="text-noir">pizza</span> ?
      </h2>
      <a
        href={locations[0]?.deliverooUrl || 'https://monboum.commande.deliveroo.fr/fr/'}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block bg-white text-rouge font-display uppercase text-lg px-12 py-5 hover:bg-noir hover:text-white transition-colors"
        data-reveal
        data-d="2"
      >
        Commander sur Deliveroo
      </a>
    </div>
  </section>
</Layout>
