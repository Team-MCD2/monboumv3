---
// ═══════════════════════════════════════════════════════════════
// /boum-pizzs — Enseigne Boum Pizz's (4 locations, some with notes)
// Hero banner: Boum-Pizzs-1.png (Pass A asset)
// ═══════════════════════════════════════════════════════════════
import Layout from '../layouts/Layout.astro';
import GrungeSeparator from '../components/GrungeSeparator.astro';
import CarteSection from '../components/CarteSection.astro';
import {
  byEnseigne,
  ENSEIGNES,
  buildEnseigneGraph,
} from '../data/restaurants.js';

const enseigne = ENSEIGNES['boum-pizzs'];
const locations = byEnseigne('boum-pizzs');

const schema = buildEnseigneGraph('boum-pizzs', Astro.site?.toString() || 'https://mon-boum.vercel.app');

const title = `${enseigne.nom} Toulouse — Pizza Géante, Tacos & Krousty Halal | Mon Boum`;
const description =
  "Boum Pizz's : pizzas artisanales (la Géante vue 180K fois sur TikTok), tacos, Krousty halal à Toulouse. 4 restaurants dans la métropole — livraison ou sur place.";
---

<Layout title={title} description={description} schema={schema}>
  {/* ═══════════════ HERO ═══════════════ */}
  <section
    class="relative texture-bg overflow-hidden"
    style="padding-top: var(--hh);"
  >
    <img
      src="/assets/shapes/shape1-min.png"
      alt=""
      aria-hidden="true"
      class="absolute top-24 -left-12 w-48 md:w-64 opacity-10 spin-slow"
      data-parallax="0.15"
    />
    <img
      src="/assets/shapes/shape3-min.png"
      alt=""
      aria-hidden="true"
      class="absolute bottom-12 right-12 w-32 md:w-48 opacity-20 float-anim"
      data-parallax="0.2"
    />

    <div class="container-wide relative z-10 py-16 md:py-20">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <p class="rise-1 font-body text-xs md:text-sm text-rouge uppercase tracking-[0.3em] mb-4">
            {enseigne.label}
          </p>
          <h1 class="rise-2 font-display text-white uppercase leading-[0.9] text-5xl md:text-7xl lg:text-8xl">
            BOUM<br />
            <span class="text-rouge">PIZZ'S.</span>
          </h1>
          <p class="rise-3 font-body text-white/70 text-lg md:text-xl mt-6 max-w-lg">
            <strong class="text-white">Pizzas artisanales</strong> à la pâte
            fine — dont la Géante vue
            <strong class="text-rouge"> 180K fois sur TikTok</strong>. Plus les
            <strong class="text-white"> tacos</strong> et le
            <strong class="text-white"> Krousty</strong>, dans
            {' '}{locations.length} restos halal.
          </p>

          <div class="rise-4 mt-8 flex flex-wrap gap-4">
            <a
              href="#locations"
              class="inline-flex items-center gap-3 bg-rouge text-white font-display uppercase text-base px-8 py-4 hover:bg-white hover:text-noir transition-colors arrow-cta pulse-rouge"
            >
              Commander
              <span data-arrow aria-hidden="true">→</span>
            </a>
            <a
              href="#concept"
              class="inline-flex items-center gap-3 border border-white/30 text-white font-display uppercase text-base px-8 py-4 hover:bg-white hover:text-noir transition-colors arrow-cta"
            >
              Le Concept
              <span data-arrow aria-hidden="true">→</span>
            </a>
          </div>
        </div>

        <div class="relative img-zoom">
          <img
            src="/assets/banners/Boum-Pizzs-1.png"
            alt="Boum Pizz's — Pizza & Tacos halal"
            class="w-full h-auto"
            width="468"
            height="471"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </section>

  <GrungeSeparator fromDark={true} />

  {/* ═══════════════ CONCEPT ═══════════════ */}
  {/* Densification : 2 paragraphes → 3 (Géante TikTok / variantes / */}
  {/* Krousty Rangueil). Stats grid enrichi (adresses / Géante 180K / */}
  {/* variantes / Krousty). Eyebrow factuel "Toulouse · 4 restos".   */}
  <section id="concept" class="bg-white py-20 md:py-28 scroll-mt-24">
    <div class="container-wide">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <div data-reveal>
          <p class="font-body text-xs text-rouge uppercase tracking-[0.3em] mb-4">
            Toulouse · {locations.length} restos
          </p>
          <h2 class="font-display text-4xl md:text-5xl text-noir uppercase leading-none mb-6">
            Pizza <span class="text-rouge">géante</span>,<br />
            tacos & Krousty.
          </h2>

          {/* Para 1 — TikTok virality + claim signature */}
          <p class="font-body text-base md:text-lg text-noir/75 leading-relaxed mb-4">
            La <strong>Pizza Géante</strong>, c'est la star :
            <strong class="text-rouge"> 180K vues sur TikTok</strong> et
            toujours plus de gens qui veulent voir ça en vrai. Pâte artisanale,
            garniture généreuse, mozzarella fil-fil — taillée pour partager
            (ou pas).
          </p>

          {/* Para 2 — variantes de carte */}
          <p class="font-body text-base md:text-lg text-noir/75 leading-relaxed mb-4">
            En plus de la Géante : <strong>Senior, Junior</strong>, et les
            spéciales <strong>Soso</strong> et <strong>Tunisienne</strong>
            (ces deux dernières uniquement à Bellefontaine, Aucamville et
            Rangueil). Côté salé non-pizza, on a les <strong>tacos</strong>
            et le <strong>Krousty</strong>.
          </p>

          {/* Para 3 — Rangueil specialty + halal */}
          <p class="font-body text-base md:text-lg text-noir/75 leading-relaxed">
            <strong>{locations.length} restos</strong> entre Toulouse et
            l'agglo. Le Krousty,
            <strong> c'est la spécialité de Rangueil</strong>. Tout est halal,
            tout est cuisiné sur place.
          </p>
        </div>

        {/* Stats grid 2×2 — claims sourced from restaurants.js + tiktoks.js */}
        <div class="grid grid-cols-2 gap-4" data-reveal data-d="2">
          <div class="bg-gris p-6 text-center">
            <p class="font-display text-4xl text-rouge mb-1">{locations.length}</p>
            <p class="font-body text-xs uppercase tracking-wider text-noir/60">Adresses</p>
          </div>
          <div class="bg-noir text-white p-6 text-center">
            <p class="font-display text-4xl text-rouge mb-1">180K</p>
            <p class="font-body text-xs uppercase tracking-wider text-white/60">Vues TikTok · Géante</p>
          </div>
          <div class="bg-noir text-white p-6 text-center">
            <p class="font-display text-3xl text-rouge mb-1">Pizza</p>
            <p class="font-body text-xs uppercase tracking-wider text-white/60">Senior · Junior · Géante</p>
          </div>
          <div class="bg-gris p-6 text-center">
            <p class="font-display text-3xl text-rouge mb-1">Krousty</p>
            <p class="font-body text-xs uppercase tracking-wider text-noir/60">Spécialité Rangueil</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ═══════════════ CARTE (Phase C — boss feedback 2026-05-04) ═══════════════ */}
  <CarteSection
    slug="boum-pizzs"
    deliverooUrl={locations[0]?.deliverooUrl || 'https://monboum.commande.deliveroo.fr/fr/'}
  />

  {/* ═══════════════ LOCATIONS ═══════════════ */}
  <section id="locations" class="bg-gris py-20 md:py-28 scroll-mt-24">
    <div class="container-wide">
      <div class="text-center mb-16" data-reveal>
        <p class="font-body text-xs text-rouge uppercase tracking-[0.3em] mb-4">
          Nos adresses
        </p>
        <h2 class="font-display text-4xl md:text-5xl text-noir uppercase leading-none">
          Retrouvez-nous<br />
          <span class="text-rouge">à Toulouse</span>.
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
        {locations.map((loc, i) => (
          <div
            class="bg-white p-8 hover:shadow-xl transition-shadow"
            data-reveal
            data-d={String(Math.min(i + 1, 4))}
          >
            <h3 class="font-display text-2xl text-noir uppercase mb-4">
              Boum Pizz's <span class="text-rouge">{loc.nom}</span>
            </h3>
            <address class="font-body text-noir/70 not-italic text-sm space-y-1">
              <p>{loc.adresse}</p>
              <p>{loc.cp} {loc.ville}</p>
              {loc.tel && (
                <p class="mt-3">
                  <a
                    href={`tel:${loc.tel.replace(/\s/g, '')}`}
                    class="text-rouge hover:underline font-medium"
                  >
                    📞 {loc.tel}
                  </a>
                </p>
              )}
            </address>
            {loc.note && (
              <p class="mt-4 pt-4 border-t border-noir/10 font-body text-xs italic text-noir/50">
                ℹ {loc.note}
              </p>
            )}
            <div class="flex flex-wrap gap-2 mt-6 pt-4 border-t border-noir/10">
              <a
                href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
                  `${loc.adresse}, ${loc.cp} ${loc.ville}`
                )}`}
                target="_blank"
                rel="noopener noreferrer"
                class="font-body text-xs bg-noir text-white px-3 py-2 uppercase tracking-wider hover:bg-rouge transition-colors"
              >
                Itinéraire
              </a>
              {loc.deliverooUrl && (
                <a
                  href={loc.deliverooUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-body text-xs bg-rouge text-white px-3 py-2 uppercase tracking-wider hover:bg-noir transition-colors"
                >
                  Commander
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ═══════════════ CTA ═══════════════ */}
  <section class="bg-rouge py-16 md:py-20">
    <div class="container-wide text-center">
      <h2 class="font-display text-4xl md:text-5xl text-white uppercase leading-none mb-8" data-reveal>
        Une envie de <span class="text-noir">pizza</span> ?
      </h2>
      <a
        href="#locations"
        class="inline-flex items-center gap-3 bg-white text-rouge font-display uppercase text-lg px-12 py-5 hover:bg-noir hover:text-white transition-colors arrow-cta"
        data-reveal
        data-d="2"
      >
        Choisir son restaurant
        <span data-arrow aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</Layout>
