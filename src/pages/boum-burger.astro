---
// ═══════════════════════════════════════════════════════════════
// /boum-burger — Enseigne Boum Burger (4 locations)
// Hero banner: BOUM-BURGER-SINCE.png (Pass A asset)
// ═══════════════════════════════════════════════════════════════
import Layout from '../layouts/Layout.astro';
import GrungeSeparator from '../components/GrungeSeparator.astro';
import CarteSection from '../components/CarteSection.astro';
import {
  byEnseigne,
  ENSEIGNES,
  buildEnseigneGraph,
} from '../data/restaurants.js';

const enseigne = ENSEIGNES['boum-burger'];
const locations = byEnseigne('boum-burger');
const drives = locations.filter((l) => l.drive).length;

const schema = buildEnseigneGraph('boum-burger', Astro.site?.toString() || 'https://mon-boum.vercel.app');

const title = `${enseigne.nom} Toulouse — Burger Halal Depuis 2004 | Mon Boum`;
const description =
  'Boum Burger : le 1er drive Fast-Food halal de France depuis 2004. Cinq burgers signés New York — Wall Street, Brooklyn, 5e Avenue, Peppertoast, New Jersey — dans nos 4 restaurants à Toulouse.';
---

<Layout title={title} description={description} schema={schema}>
  {/* ═══════════════ HERO ═══════════════ */}
  <section
    class="relative texture-bg overflow-hidden"
    style="padding-top: var(--hh);"
  >
    <img
      src="/assets/shapes/shape1-min.png"
      alt=""
      aria-hidden="true"
      class="absolute top-24 -left-12 w-48 md:w-64 opacity-10 spin-slow"
      data-parallax="0.15"
    />
    <img
      src="/assets/shapes/shape2-min.png"
      alt=""
      aria-hidden="true"
      class="absolute bottom-24 right-8 w-32 md:w-48 opacity-20 float-anim"
      data-parallax="0.2"
    />

    <div class="container-wide relative z-10 py-16 md:py-20">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <p class="rise-1 font-body text-xs md:text-sm text-rouge uppercase tracking-[0.3em] mb-4">
            {enseigne.label}
          </p>
          <h1 class="rise-2 font-display text-white uppercase leading-[0.9] text-5xl md:text-7xl lg:text-8xl">
            BOUM<br />
            <span class="text-rouge">BURGER.</span>
          </h1>
          <p class="rise-3 font-body text-white/70 text-lg md:text-xl mt-6 max-w-lg">
            Le <strong class="text-white">1er drive Fast-Food halal de France</strong>,
            depuis <strong class="text-white">2004</strong>. Cinq burgers signés
            New York — Wall Street, Brooklyn, 5e Avenue — servis dans
            <strong class="text-white"> {locations.length} restaurants</strong>.
          </p>

          <div class="rise-4 mt-8 flex flex-wrap gap-4">
            <a
              href="#locations"
              class="inline-flex items-center gap-3 bg-rouge text-white font-display uppercase text-base px-8 py-4 hover:bg-white hover:text-noir transition-colors arrow-cta pulse-rouge"
            >
              Commander
              <span data-arrow aria-hidden="true">→</span>
            </a>
            <a
              href="#concept"
              class="inline-flex items-center gap-3 border border-white/30 text-white font-display uppercase text-base px-8 py-4 hover:bg-white hover:text-noir transition-colors arrow-cta"
            >
              Le Concept
              <span data-arrow aria-hidden="true">→</span>
            </a>
          </div>
        </div>

        <div class="relative img-zoom">
          <img
            src="/assets/banners/BOUM-BURGER-SINCE.png"
            alt="Boum Burger — Halal depuis 2004"
            class="w-full h-auto"
            width="635"
            height="376"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </section>

  <GrungeSeparator fromDark={true} />

  {/* ═══════════════ CONCEPT ═══════════════ */}
  {/* Densification : 1 line "smash burger" → 3 paragraphs (origine /     */}
  {/* NYC theme / qualité+livraison). Stats grid 2×2 cohérent (2004 /     */}
  {/* restos / drives / signature). Derived from restaurants.js + menus.js*/}
  <section id="concept" class="bg-white py-20 md:py-28 scroll-mt-24">
    <div class="container-wide">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <div data-reveal>
          <p class="font-body text-xs text-rouge uppercase tracking-[0.3em] mb-4">
            Toulouse · 2004
          </p>
          <h2 class="font-display text-4xl md:text-5xl text-noir uppercase leading-none mb-6">
            Cinq burgers,<br />
            <span class="text-rouge">cinq quartiers</span> de NYC.
          </h2>

          {/* Para 1 — origine + drive halal France */}
          <p class="font-body text-base md:text-lg text-noir/75 leading-relaxed mb-4">
            Tout commence en <strong>2004</strong> à Toulouse. Une équipe d'ici
            décide de monter le <strong class="text-rouge">1er fast-food halal
            en mode drive de France</strong>. Vingt ans plus tard, on est
            toujours là.
          </p>

          {/* Para 2 — NYC theme + signature burgers (sourced menus.js) */}
          <p class="font-body text-base md:text-lg text-noir/75 leading-relaxed mb-4">
            <strong>Cinq burgers, cinq quartiers</strong> : Wall Street,
            Brooklyn, 5e Avenue, Peppertoast, New Jersey. Chacun sa
            personnalité, tous taillés pour les vraies faims. Plus le
            <strong> Tacos XXL</strong> pour ceux qui choisissent pas.
          </p>

          {/* Para 3 — qualité + modes */}
          <p class="font-body text-base md:text-lg text-noir/75 leading-relaxed">
            Viandes halal certifiées, pains artisanaux, sauces maison.
            <strong> Sur place, en drive, en livraison</strong> — dans nos
            {' '}{locations.length} restos toulousains.
          </p>
        </div>

        {/* Stats grid 2×2 — derived counts */}
        <div class="grid grid-cols-2 gap-4" data-reveal data-d="2">
          <div class="bg-gris p-6 text-center">
            <p class="font-display text-4xl text-rouge mb-1">2004</p>
            <p class="font-body text-xs uppercase tracking-wider text-noir/60">Depuis</p>
          </div>
          <div class="bg-gris p-6 text-center">
            <p class="font-display text-4xl text-rouge mb-1">{locations.length}</p>
            <p class="font-body text-xs uppercase tracking-wider text-noir/60">Restaurants</p>
          </div>
          <div class="bg-gris p-6 text-center">
            <p class="font-display text-4xl text-rouge mb-1">{drives}</p>
            <p class="font-body text-xs uppercase tracking-wider text-noir/60">Drives</p>
          </div>
          <div class="bg-noir text-white p-6 text-center">
            <p class="font-display text-4xl text-rouge mb-1">5</p>
            <p class="font-body text-xs uppercase tracking-wider text-white/60">Burgers NYC</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ═══════════════ CARTE (Phase C — boss feedback 2026-05-04) ═══════════════ */}
  <CarteSection
    slug="boum-burger"
    deliverooUrl={locations[0]?.deliverooUrl || 'https://monboum.commande.deliveroo.fr/fr/'}
  />

  {/* ═══════════════ LOCATIONS ═══════════════ */}
  <section id="locations" class="bg-gris py-20 md:py-28 scroll-mt-24">
    <div class="container-wide">
      <div class="text-center mb-16" data-reveal>
        <p class="font-body text-xs text-rouge uppercase tracking-[0.3em] mb-4">
          Nos adresses
        </p>
        <h2 class="font-display text-4xl md:text-5xl text-noir uppercase leading-none">
          Retrouvez-nous<br />
          <span class="text-rouge">à Toulouse</span>.
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
        {locations.map((loc, i) => (
          <div
            class="bg-white p-8 hover:shadow-xl transition-shadow"
            data-reveal
            data-d={String(Math.min(i + 1, 4))}
          >
            <div class="flex items-start justify-between mb-4">
              <h3 class="font-display text-2xl text-noir uppercase">
                Boum Burger <span class="text-rouge">{loc.nom}</span>
              </h3>
              {loc.drive && (
                <span class="font-body text-xs bg-rouge text-white px-2 py-1 uppercase tracking-wider">
                  Drive
                </span>
              )}
            </div>
            <address class="font-body text-noir/70 not-italic text-sm space-y-1">
              <p>{loc.adresse}</p>
              <p>{loc.cp} {loc.ville}</p>
              {loc.tel && (
                <p class="mt-3">
                  <a
                    href={`tel:${loc.tel.replace(/\s/g, '')}`}
                    class="text-rouge hover:underline font-medium"
                  >
                    📞 {loc.tel}
                  </a>
                </p>
              )}
            </address>
            <div class="flex flex-wrap gap-2 mt-6 pt-4 border-t border-noir/10">
              <a
                href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
                  `${loc.adresse}, ${loc.cp} ${loc.ville}`
                )}`}
                target="_blank"
                rel="noopener noreferrer"
                class="font-body text-xs bg-noir text-white px-3 py-2 uppercase tracking-wider hover:bg-rouge transition-colors"
              >
                Itinéraire
              </a>
              {loc.deliverooUrl && (
                <a
                  href={loc.deliverooUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-body text-xs bg-rouge text-white px-3 py-2 uppercase tracking-wider hover:bg-noir transition-colors"
                >
                  Commander
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ═══════════════ CTA ═══════════════ */}
  <section class="bg-rouge py-16 md:py-20">
    <div class="container-wide text-center">
      <h2 class="font-display text-4xl md:text-5xl text-white uppercase leading-none mb-8" data-reveal>
        Envie d'un <span class="text-noir">boum burger</span> ?
      </h2>
      <a
        href="#locations"
        class="inline-flex items-center gap-3 bg-white text-rouge font-display uppercase text-lg px-12 py-5 hover:bg-noir hover:text-white transition-colors arrow-cta"
        data-reveal
        data-d="2"
      >
        Choisir son restaurant
        <span data-arrow aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</Layout>
