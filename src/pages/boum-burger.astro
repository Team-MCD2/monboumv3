---
// ═══════════════════════════════════════════════════════════════
// /boum-burger — Enseigne Boum Burger (4 locations)
// Hero banner: BOUM-BURGER-SINCE.png (Pass A asset)
// ═══════════════════════════════════════════════════════════════
import Layout from '../layouts/Layout.astro';
import GrungeSeparator from '../components/GrungeSeparator.astro';
import { byEnseigne, ENSEIGNES } from '../data/restaurants.js';

const enseigne = ENSEIGNES['boum-burger'];
const locations = byEnseigne('boum-burger');

const title = `${enseigne.nom} Toulouse — Burger Halal Depuis 2004 | Mon Boum`;
const description =
  'Boum Burger : le 1er drive Fast-Food halal de France depuis 2004. Découvrez nos burgers halal dans nos 4 restaurants à Toulouse.';
---

<Layout title={title} description={description}>
  {/* ═══════════════ HERO ═══════════════ */}
  <section
    class="relative texture-bg overflow-hidden"
    style="padding-top: var(--hh);"
  >
    <img
      src="/assets/shapes/shape1-min.png"
      alt=""
      aria-hidden="true"
      class="absolute top-24 -left-12 w-48 md:w-64 opacity-10 spin-slow"
      data-parallax="0.15"
    />
    <img
      src="/assets/shapes/shape2-min.png"
      alt=""
      aria-hidden="true"
      class="absolute bottom-24 right-8 w-32 md:w-48 opacity-20 float-anim"
      data-parallax="0.2"
    />

    <div class="container-wide relative z-10 py-16 md:py-20">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <p class="rise-1 font-body text-xs md:text-sm text-rouge uppercase tracking-[0.3em] mb-4">
            {enseigne.label}
          </p>
          <h1 class="rise-2 font-display text-white uppercase leading-[0.9] text-5xl md:text-7xl lg:text-8xl">
            BOUM<br />
            <span class="text-rouge">BURGER.</span>
          </h1>
          <p class="rise-3 font-body text-white/70 text-lg md:text-xl mt-6 max-w-lg">
            Le <strong class="text-white">1er drive Fast-Food halal de France</strong>,
            depuis <strong class="text-white">2004</strong>.
          </p>

          <div class="rise-4 mt-8 flex flex-wrap gap-4">
            <a
              href="https://monboum.commande.deliveroo.fr/fr/"
              target="_blank"
              rel="noopener noreferrer"
              class="bg-rouge text-white font-display uppercase text-base px-8 py-4 hover:bg-white hover:text-noir transition-colors"
            >
              Commander
            </a>
            <a
              href="#locations"
              class="border border-white/30 text-white font-display uppercase text-base px-8 py-4 hover:bg-white hover:text-noir transition-colors"
            >
              Nos adresses
            </a>
          </div>
        </div>

        <div class="relative img-zoom">
          <img
            src="/assets/banners/BOUM-BURGER-SINCE.png"
            alt="Boum Burger — Halal depuis 2004"
            class="w-full h-auto"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </section>

  <GrungeSeparator fromDark={true} />

  {/* ═══════════════ CONCEPT ═══════════════ */}
  <section class="bg-white py-20 md:py-28">
    <div class="container-wide">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <div data-reveal>
          <p class="font-body text-xs text-rouge uppercase tracking-[0.3em] mb-4">
            Notre concept
          </p>
          <h2 class="font-display text-4xl md:text-5xl text-noir uppercase leading-none mb-6">
            Le <span class="text-rouge">smash burger</span><br />
            qui a tout changé.
          </h2>
          <div class="space-y-4 font-body text-noir/70">
            <p>
              Depuis 2004, Boum Burger met la <strong>qualité halal</strong> au
              cœur du Street-Food toulousain. Viandes certifiées, pains artisanaux,
              sauces maison.
            </p>
            <p>
              4 restaurants, dont <strong>3 avec drive</strong>, pour vous
              servir le meilleur burger halal de la région toulousaine.
            </p>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4" data-reveal data-d="2">
          <div class="bg-gris p-6 text-center">
            <p class="font-display text-4xl text-rouge mb-1">{locations.length}</p>
            <p class="font-body text-xs uppercase tracking-wider text-noir/60">Restaurants</p>
          </div>
          <div class="bg-gris p-6 text-center">
            <p class="font-display text-4xl text-rouge mb-1">
              {locations.filter((l) => l.drive).length}
            </p>
            <p class="font-body text-xs uppercase tracking-wider text-noir/60">Drives</p>
          </div>
          <div class="bg-gris p-6 text-center col-span-2">
            <p class="font-display text-4xl text-rouge mb-1">Depuis 2004</p>
            <p class="font-body text-xs uppercase tracking-wider text-noir/60">
              1er drive halal de France
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ═══════════════ LOCATIONS ═══════════════ */}
  <section id="locations" class="bg-gris py-20 md:py-28 scroll-mt-24">
    <div class="container-wide">
      <div class="text-center mb-16" data-reveal>
        <p class="font-body text-xs text-rouge uppercase tracking-[0.3em] mb-4">
          Nos adresses
        </p>
        <h2 class="font-display text-4xl md:text-5xl text-noir uppercase leading-none">
          Retrouvez-nous<br />
          <span class="text-rouge">à Toulouse</span>.
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
        {locations.map((loc, i) => (
          <div
            class="bg-white p-8 hover:shadow-xl transition-shadow"
            data-reveal
            data-d={String(Math.min(i + 1, 4))}
          >
            <div class="flex items-start justify-between mb-4">
              <h3 class="font-display text-2xl text-noir uppercase">
                Boum Burger <span class="text-rouge">{loc.nom}</span>
              </h3>
              {loc.drive && (
                <span class="font-body text-xs bg-rouge text-white px-2 py-1 uppercase tracking-wider">
                  Drive
                </span>
              )}
            </div>
            <address class="font-body text-noir/70 not-italic text-sm space-y-1">
              <p>{loc.adresse}</p>
              <p>{loc.cp} {loc.ville}</p>
              {loc.tel && (
                <p class="mt-3">
                  <a
                    href={`tel:${loc.tel.replace(/\s/g, '')}`}
                    class="text-rouge hover:underline font-medium"
                  >
                    📞 {loc.tel}
                  </a>
                </p>
              )}
            </address>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ═══════════════ CTA ═══════════════ */}
  <section class="bg-rouge py-16 md:py-20">
    <div class="container-wide text-center">
      <h2 class="font-display text-4xl md:text-5xl text-white uppercase leading-none mb-8" data-reveal>
        Envie d'un <span class="text-noir">boum burger</span> ?
      </h2>
      <a
        href="https://monboum.commande.deliveroo.fr/fr/"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block bg-white text-rouge font-display uppercase text-lg px-12 py-5 hover:bg-noir hover:text-white transition-colors"
        data-reveal
        data-d="2"
      >
        Commander sur Deliveroo
      </a>
    </div>
  </section>
</Layout>
