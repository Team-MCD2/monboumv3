---
// ═══════════════════════════════════════════════════════════════
// Layout.astro — master wrapper for every page
// Spec: plan/plan.md lines 172-218
// Includes: SEO meta, OG tags, JSON-LD, GA4 stub, fonts, Header/Footer,
// scroll-reveal + header-height + parallax scripts
// ═══════════════════════════════════════════════════════════════
import '../styles/globals.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface FaqItem { q: string; a: string; }

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  faq?: FaqItem[];
  schema?: Record<string, unknown>;
  noindex?: boolean;
}

const {
  title,
  description,
  ogImage = '/assets/logos/Boums.png',
  faq = [],
  schema,
  noindex = false,
} = Astro.props;

const canonicalUrl = Astro.url.href;
// GA4 measurement ID — read from env; leave empty in .env to disable analytics
const GA_ID = import.meta.env.PUBLIC_GA4_ID || '';

const faqJsonLd = faq.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
} : null;
---

<!DOCTYPE html>
<html lang="fr">
  <head>
    <!-- Primary meta -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />

    <!-- Favicon (company logo only) + PWA manifest -->
    <link rel="icon" type="image/png" sizes="192x192" href="/assets/icons/icon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/assets/icons/icon-512.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="apple-mobile-web-app-title" content="Mon Boum" />

    <!-- OpenGraph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.url).href} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Mon Boum" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.url).href} />

    <!-- Theme color (for PWA / Android tabs) -->
    <meta name="theme-color" content="#111111" />

    <!-- JSON-LD (FAQ) -->
    {faqJsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
    )}

    <!-- JSON-LD (custom schema, e.g. LocalBusiness per enseigne) -->
    {schema && (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}

    <!-- GA4 — only loads when PUBLIC_GA4_ID is set in env + only in prod builds -->
    {import.meta.env.PROD && GA_ID && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
        <script is:inline define:vars={{ GA_ID }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', GA_ID, { anonymize_ip: true });
        </script>
      </>
    )}
  </head>

  <body>
    <a href="#main" class="skip-link">Aller au contenu principal</a>

    <!-- Top announcement marquee (Phase G, 2026-05-05) ─────────── -->
    <div class="bg-noir text-white py-1.5 overflow-hidden border-b border-white/10">
      <div class="marquee-inner-slow font-display uppercase text-[11px] md:text-xs tracking-[0.22em]">
        {Array.from({ length: 8 }).map(() => (
          <span class="mx-6 whitespace-nowrap flex items-center gap-6">
            <span>Ouvert 7/7</span>
            <span class="text-rouge">●</span>
            <span>Livraison Deliveroo</span>
            <span class="text-rouge">●</span>
            <span>10 restaurants à Toulouse</span>
            <span class="text-rouge">●</span>
            <span>Halal depuis 2004</span>
            <span class="text-rouge">●</span>
          </span>
        ))}
      </div>
    </div>

    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer />

    <script>
      // ── Scroll reveal (IntersectionObserver) ──────────────────
      const mq = window.matchMedia('(prefers-reduced-motion: reduce)');
      if (!mq.matches) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('visible');
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.07 }
        );
        document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
      } else {
        // Reduced motion → mark everything visible immediately
        document.querySelectorAll('[data-reveal]').forEach((el) => {
          el.classList.add('visible');
        });
      }

      // ── Header height CSS var (drives --hh for all hero padding-top) ──
      function setHeaderHeight() {
        const hdr = document.querySelector('header');
        if (hdr) {
          document.documentElement.style.setProperty('--hh', `${hdr.offsetHeight}px`);
        }
      }
      setHeaderHeight();
      window.addEventListener('resize', setHeaderHeight, { passive: true });

      // ── Parallax (respects reduced motion) ────────────────────
      if (!mq.matches) {
        const parallaxEls = document.querySelectorAll<HTMLElement>('[data-parallax]');
        if (parallaxEls.length > 0) {
          window.addEventListener(
            'scroll',
            () => {
              const y = window.scrollY;
              parallaxEls.forEach((el) => {
                const speed = parseFloat(el.dataset.parallax || '0.15');
                el.style.transform = `translateY(${y * speed}px)`;
              });
            },
            { passive: true }
          );
        }
      }
    </script>
  </body>
</html>
