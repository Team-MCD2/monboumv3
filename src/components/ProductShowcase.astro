---
// ═══════════════════════════════════════════════════════════════
// ProductShowcase — Phase D / boss feedback 2026-05-04
//
// "Vraiement mettre en avant les produits - regarder burgerking"
//
// IMAGE AUDIT (2026-05-18) — the original 6-card grid mixed clean
// hero food photography (5 NYC burgers) with 3 scanned menu boards
// (Boum Chicken bucket / Boum Pizz's carte / Boum Saveurs assiettes)
// whose images had consumer-facing prices baked in (19,90€, 8,50€,
// etc.) — direct violation of boss feedback "ne pas avoir le prix
// sur les photos pour mettre en avant les produits". Until the
// three other enseignes get clean hero photography (PHOTO_TODO),
// the grid is restricted to the 5 NYC burger close-ups — all
// professional, all price-free, all 4:3-friendly.
//
// Design language: bg-noir, oversized food photo, Anton uppercase
// product name, rouge enseigne label, hover scale + border accent.
// Inspired by Burger King's product-led hero (boss reference) and
// pointb-officiel.com's "à la carte!" pattern.
//
// See .project-store/decisions.md ADR-006 (product photo source),
// ADR-008 (reference contextualisation), log.md 2026-05-18 entry.
// ═══════════════════════════════════════════════════════════════

// PHOTO_TODO — once Boum Chicken / Boum Pizz's / Boum Saveurs have
// clean hero shots (no prices, no menu-board scans), expand back to
// a cross-enseigne 6-card grid and refresh the subtitle copy.
const products = [
  {
    name: 'Wall Street',
    enseigne: 'Boum Burger',
    tagline: 'Le burger signature qui a tout d\u00e9clench\u00e9.',
    image: '/assets/products/burger-wallstreet.jpg',
    href: '/boum-burger',
  },
  {
    name: 'Brooklyn',
    enseigne: 'Boum Burger',
    tagline: 'L\u2019option veggie qui fait l\u2019unanimit\u00e9.',
    image: '/assets/products/burger-brooklyn.jpg',
    href: '/boum-burger',
  },
  {
    name: '5\u00e8me Avenue',
    enseigne: 'Boum Burger',
    tagline: 'Avenue gourmande direct dans ton sandwich.',
    image: '/assets/products/burger-5eme-avenue.jpg',
    href: '/boum-burger',
  },
  {
    name: 'Peppertoast',
    enseigne: 'Boum Burger',
    tagline: 'Du poivre, du fondant, du caract\u00e8re.',
    image: '/assets/products/burger-peppertoast.jpg',
    href: '/boum-burger',
  },
  {
    name: 'New Jersey',
    enseigne: 'Boum Burger',
    tagline: 'Le double-galette qui en redemande.',
    image: '/assets/products/burger-new-jersey.jpg',
    href: '/boum-burger',
  },
];
---

<section class="bg-noir-deep py-20 md:py-28 relative overflow-hidden">
  {/* Decorative grunge shape — same primitive as sections 5/7 */}
  <img
    src="/assets/shapes/shape1-min.png"
    alt=""
    aria-hidden="true"
    class="absolute -top-16 -right-12 w-64 md:w-80 opacity-[0.04] spin-slow"
    data-parallax="0.12"
  />
  <img
    src="/assets/shapes/shape3-min.png"
    alt=""
    aria-hidden="true"
    class="absolute bottom-12 -left-16 w-48 opacity-[0.04] float-anim"
  />

  <div class="container-wide relative z-10">
    {/* Heading */}
    <div class="text-center mb-12 md:mb-16" data-reveal>
      <p class="font-body text-xs text-rouge uppercase tracking-[0.3em] mb-4">
        Les stars du moment
      </p>
      <h2 class="font-display text-5xl md:text-6xl lg:text-7xl text-white uppercase leading-none">
        Faites <span class="text-rouge">chauffer</span><br />
        l&rsquo;envie.
      </h2>
      <p class="font-body text-base text-white/60 mt-6 max-w-xl mx-auto">
        Cinq burgers sign&eacute;s New York &mdash; la collection
        signature Boum Burger. Pizz&rsquo;s, Chicken, Saveurs : voir
        leurs cartes d&eacute;di&eacute;es.
      </p>
    </div>

    {/* Grid : 5 items → split into 3 + 2 centered row to avoid the orphan-  */}
    {/* row asymmetry that `grid-cols-3` would otherwise produce. Same       */}
    {/* card markup, only the row container differs.                        */}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8 mb-6 md:mb-8">
      {products.slice(0, 3).map((p, i) => (
        <a
          href={p.href}
          class="group relative block overflow-hidden bg-noir border border-white/10 hover:border-rouge transition-all duration-300 shine-card hover-lift arrow-cta"
          data-reveal
          data-d={String((i % 3) + 1)}
        >
          <div class="aspect-[4/3] overflow-hidden bg-noir">
            <img
              src={p.image}
              alt={`${p.name} — ${p.enseigne}`}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
              width="1200"
              height="900"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="p-6 md:p-7">
            <p class="font-body text-[10px] text-rouge uppercase tracking-[0.25em] mb-2">
              {p.enseigne}
            </p>
            <h3 class="font-display text-2xl md:text-3xl text-white uppercase leading-none mb-3 group-hover:text-rouge transition-colors">
              {p.name}
            </h3>
            <p class="font-body text-sm text-white/60 leading-relaxed">
              {p.tagline}
            </p>
          </div>
          <span
            class="absolute top-4 right-4 bg-rouge text-white font-display uppercase text-xs px-3 py-1.5 shadow-lg flex items-center gap-1 transform transition-transform duration-300 group-hover:scale-110"
            aria-hidden="true"
          >
            Voir <span data-arrow>→</span>
          </span>
        </a>
      ))}
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 md:gap-8 max-w-3xl mx-auto">
      {products.slice(3).map((p, i) => (
        <a
          href={p.href}
          class="group relative block overflow-hidden bg-noir border border-white/10 hover:border-rouge transition-all duration-300 shine-card hover-lift arrow-cta"
          data-reveal
          data-d={String((i % 3) + 1)}
        >
          <div class="aspect-[4/3] overflow-hidden bg-noir">
            <img
              src={p.image}
              alt={`${p.name} — ${p.enseigne}`}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
              width="1200"
              height="900"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="p-6 md:p-7">
            <p class="font-body text-[10px] text-rouge uppercase tracking-[0.25em] mb-2">
              {p.enseigne}
            </p>
            <h3 class="font-display text-2xl md:text-3xl text-white uppercase leading-none mb-3 group-hover:text-rouge transition-colors">
              {p.name}
            </h3>
            <p class="font-body text-sm text-white/60 leading-relaxed">
              {p.tagline}
            </p>
          </div>
          <span
            class="absolute top-4 right-4 bg-rouge text-white font-display uppercase text-xs px-3 py-1.5 shadow-lg flex items-center gap-1 transform transition-transform duration-300 group-hover:scale-110"
            aria-hidden="true"
          >
            Voir <span data-arrow>→</span>
          </span>
        </a>
      ))}
    </div>

    {/* Tail CTA */}
    <div class="text-center mt-12 md:mt-16" data-reveal>
      <a
        href="https://monboum.commande.deliveroo.fr/fr/"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 bg-rouge text-white font-display uppercase text-base px-10 py-5 hover:bg-white hover:text-rouge transition-colors arrow-cta pulse-rouge"
      >
        Commander tout ça
        <span data-arrow aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>
