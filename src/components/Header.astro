---
// ═══════════════════════════════════════════════════════════════
// Header — ALWAYS white, sticky, h-[70px] desktop / h-[60px] mobile
// Spec: plan/plan.md lines 219-231
// Rules: #02 (padding-top via --hh), #13 (logo intact, no coloured container)
// ═══════════════════════════════════════════════════════════════

const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/mon-boum', label: 'Mon Boum' },
  { href: '/nos-restaurants', label: 'Nos Restaurants', hasDropdown: true },
  { href: '/formulaire-de-candidature', label: 'Devenir Franchisé' },
  { href: '/contact', label: 'Contact' },
];

const enseignes = [
  { href: '/boum-burger', label: 'Boum Burger' },
  { href: '/boum-pizzs', label: "Boum Pizz's" },
  { href: '/boum-chicken', label: 'Boum Chicken' },
  { href: '/boum-saveurs', label: 'Boum Saveurs' },
  { href: '/nos-restaurants', label: 'Tous nos restaurants', divider: true },
];
---

<header
  class="sticky top-0 z-50 bg-white"
  style="box-shadow: 0 1px 0 rgba(0,0,0,0.08);"
>
  <div class="container-wide">
    <div class="flex items-center justify-between h-[60px] md:h-[70px]">
      <!-- Logo ─────────────────────────────────────────────── -->
      <a href="/" class="flex items-center" aria-label="Mon Boum — Accueil">
        <img
          src="/assets/logos/logo-mon-boum-home.png"
          alt="Mon Boum"
          class="h-[52px] md:h-[64px] max-h-full w-auto object-contain"
          width="160"
          height="40"
        />
      </a>

      <!-- Desktop nav ──────────────────────────────────────── -->
      <nav class="hidden lg:flex items-center gap-8" aria-label="Navigation principale">
        {navLinks.map((link) => (
          <div class="relative group">
            <a
              href={link.href}
              class:list={[
                'font-body text-sm uppercase tracking-wider transition-colors',
                currentPath === link.href
                  ? 'text-rouge font-semibold'
                  : 'text-noir hover:text-rouge',
              ]}
            >
              {link.label}
              {link.hasDropdown && (
                <svg class="inline-block w-3 h-3 ml-1 -mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              )}
            </a>

            {link.hasDropdown && (
              <div class="absolute top-full left-0 mt-0 w-56 bg-white shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 py-2 border-t-2 border-rouge">
                {enseignes.map((e) => (
                  <>
                    {e.divider && <div class="border-t border-gray-200 my-1"></div>}
                    <a
                      href={e.href}
                      class="block px-4 py-2 font-body text-sm text-noir hover:bg-gris hover:text-rouge transition-colors"
                    >
                      {e.label}
                    </a>
                  </>
                ))}
              </div>
            )}
          </div>
        ))}
      </nav>

      <!-- CTA desktop + mobile burger ─────────────────────── -->
      <div class="flex items-center gap-4">
        <a
          href="https://monboum.commande.deliveroo.fr/fr/"
          target="_blank"
          rel="noopener noreferrer"
          class="hidden md:inline-block bg-rouge text-white font-display uppercase text-sm px-5 py-2 hover:bg-noir transition-colors"
        >
          Commander
        </a>

        <!-- Burger (mobile) -->
        <button
          id="mobile-menu-toggle"
          class="lg:hidden flex flex-col gap-1.5 p-2"
          aria-label="Ouvrir le menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <span class="block w-6 h-0.5 bg-noir transition-transform"></span>
          <span class="block w-6 h-0.5 bg-noir transition-opacity"></span>
          <span class="block w-6 h-0.5 bg-noir transition-transform"></span>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile overlay menu ──────────────────────────────────── -->
  <div
    id="mobile-menu"
    class="fixed inset-0 bg-noir z-40 transform translate-x-full transition-transform duration-300 lg:hidden"
    aria-hidden="true"
  >
    <div class="flex flex-col h-full pt-[60px] overflow-y-auto">
      <nav class="flex flex-col p-8 gap-6" aria-label="Navigation mobile">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="font-display text-3xl text-white uppercase hover:text-rouge transition-colors"
          >
            {link.label}
          </a>
        ))}

        <div class="border-t border-white/20 pt-6 mt-4">
          <p class="font-body text-xs text-white/50 uppercase tracking-wider mb-4">
            Nos Enseignes
          </p>
          {enseignes.filter((e) => !e.divider).map((e) => (
            <a
              href={e.href}
              class="block font-body text-lg text-white/80 uppercase mb-3 hover:text-rouge transition-colors"
            >
              {e.label}
            </a>
          ))}
        </div>

        <a
          href="https://monboum.commande.deliveroo.fr/fr/"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-8 bg-rouge text-white font-display uppercase text-xl px-6 py-4 text-center hover:bg-white hover:text-rouge transition-colors"
        >
          Commander
        </a>
      </nav>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const spans = toggleBtn?.querySelectorAll('span');

  function setMenuOpen(open: boolean) {
    if (!menu || !toggleBtn || !spans) return;
    menu.classList.toggle('translate-x-full', !open);
    menu.setAttribute('aria-hidden', String(!open));
    toggleBtn.setAttribute('aria-expanded', String(open));
    toggleBtn.setAttribute(
      'aria-label',
      open ? 'Fermer le menu' : 'Ouvrir le menu'
    );
    // Burger → X animation (only when open, reset otherwise)
    spans[0].classList.toggle('rotate-45', open);
    spans[0].classList.toggle('translate-y-2', open);
    spans[1].classList.toggle('opacity-0', open);
    spans[2].classList.toggle('-rotate-45', open);
    spans[2].classList.toggle('-translate-y-2', open);

    document.body.style.overflow = open ? 'hidden' : '';
  }

  if (toggleBtn && menu && spans) {
    toggleBtn.addEventListener('click', () => {
      const isCurrentlyClosed = menu.classList.contains('translate-x-full');
      setMenuOpen(isCurrentlyClosed);
    });

    // Polish: auto-close the mobile menu when any link inside it is clicked.
    // Astro does full page navigation, so the menu would close on load anyway,
    // but optimistic close makes the transition feel snappy.
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setMenuOpen(false));
    });

    // Also close on Escape key for keyboard users
    document.addEventListener('keydown', (e) => {
      if (
        e.key === 'Escape' &&
        !menu.classList.contains('translate-x-full')
      ) {
        setMenuOpen(false);
        toggleBtn.focus();
      }
    });
  }
</script>
