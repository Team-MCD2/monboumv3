---

<GrungeSeparator fromDark={false} />

<footer class="texture-bg-deep text-white">
  <div class="container-wide py-12 md:py-16">
    <!-- Top block: Logo + Tagline + 4 cols ─────────────────── -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8 mb-12">
      <!-- Logo + tagline (spans 2 cols on lg) -->
      <div class="lg:col-span-2">
        <img
          src="/assets/logos/footer_logo-boum.png"
          alt="Mon Boum"
          class="h-12 w-auto mb-4"
          width="120"
          height="48"
        />
        <p class="font-display text-xl md:text-2xl uppercase leading-tight">
          Le meilleur du<br />
          <span class="text-rouge">Street-Food</span> depuis 2004.
        </p>

        <!-- Socials -->
        <div class="flex gap-3 mt-6">
          {socialLinks.map((social) => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              class="w-10 h-10 border border-white/20 rounded-full flex items-center justify-center hover:bg-rouge hover:border-rouge transition-colors"
              aria-label={social.label}
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d={social.icon} />
              </svg>
            </a>
          ))}
        </div>
      </div>

      <!-- Nav columns -->
      {navColumns.map((col) => (
        <div>
          <h3 class="font-display uppercase text-sm text-rouge mb-4 tracking-wider">
            {col.title}
          </h3>
          <ul class="space-y-2">
            {col.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="font-body text-sm text-white/70 hover:text-white transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Divider -->
    <div class="border-t border-white/10 pt-8">
      <!-- Legal SIRET block -->
      <p class="font-body text-xs text-white/50 leading-relaxed mb-4">
        <strong class="text-white/70">BOUM BURGER</strong> · SARL ·
        SIREN 500 373 311 · SIRET 500 373 311 00017 ·
        RCS Toulouse · APE 5610C ·
        220 route de Saint-Simon, 31100 Toulouse
      </p>

      <!-- Contact email -->
      <p class="font-body text-xs text-white/50 mb-6">
        Contact franchise:
        <a href="mailto:franchise@monboum.fr" class="text-rouge hover:underline">
          franchise@monboum.fr
        </a>
      </p>

      <!-- Copyright + Microdidact -->
      <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-2 text-xs text-white/40">
        <p>© 2004–{currentYear} Mon Boum. Tous droits réservés.</p>
        <p>
          Fait par
          <a
            href="https://microdidact.com/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-white/70 hover:text-rouge transition-colors"
          >
            Microdidact
          </a>
        </p>
      </div>
    </div>
  </div>
</footer>
