// Owns its own top GrungeSeparator (issue 2.9 decision)
// ═══════════════════════════════════════════════════════════════
import GrungeSeparator from './GrungeSeparator.astro';

const currentYear = new Date().getFullYear();

const navColumns = [
  {
    title: 'Navigation',
    links: [
      { href: '/', label: 'Accueil' },
      { href: '/mon-boum', label: 'Mon Boum' },
      { href: '/nos-restaurants', label: 'Nos Restaurants' },
      { href: '/formulaire-de-candidature', label: 'Devenir Franchisé' },
      { href: '/contact', label: 'Contact' },
    ],
  },
  {
    title: 'Enseignes',
    links: [
      { href: '/boum-burger', label: 'Boum Burger' },
      { href: '/boum-pizzs', label: "Boum Pizz's" },
      { href: '/boum-chicken', label: 'Boum Chicken' },
      { href: '/boum-saveurs', label: 'Boum Saveurs' },
    ],
  },
  {
    title: 'Légal',
    links: [
      { href: '/mentions-legales', label: 'Mentions légales' },
      { href: '/mentions-legales#donnees', label: 'Données personnelles' },
      { href: '/mentions-legales#cookies', label: 'Cookies' },
    ],
  },
];

const socialLinks = [
  {
